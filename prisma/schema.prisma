generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES
}

enum ServiceStatus {
  SCHEDULED
  EXECUTED
  INVOICED
}

enum CustomerType {
  NATURAL_PERSON
  COMPANY
}

model User {
  tutorialStep Int @default(0)
  tutorialCompleted Boolean @default(false)
  id       String @id @default(cuid())
  username String @unique
  password String
  role     Role
  salespersonId String?
  salesperson Salesperson? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
}

enum ClassModality {
  VIRTUAL
  IN_PERSON
  MIXED
}

enum TravelMode {
  NONE
  PLANE
  BUS
}

model Instructor {
  address      String?
  dni          String?
  courseNotes  String?
  courses      Course[] @relation("InstructorCourses")
  emoExpiresAt DateTime?
  sctr         Boolean @default(false)
  sctrStartsAt DateTime?
  sctrEndsAt   DateTime?
  carModel     String?
  carPlate     String?
  id       String    @id @default(cuid())
  name     String    @unique
  services Service[]
}

model Course {
  quotations Quotation[] @relation("QuotationCourses")
  id               String            @id @default(cuid())
  name             String            @unique
  services         Service[]
  certificateSales CertificateSale[]
  instructors      Instructor[] @relation("InstructorCourses")
  groupedServices  Service[] @relation("ServiceCourses")
}

model Salesperson {
  quotations Quotation[]
  id               String            @id @default(cuid())
  name             String            @unique
  color            String            @default("#234eaa")
  users            User[]
  services         Service[]
  certificateSales CertificateSale[]
}

model Location {
  id         String    @id @default(cuid())
  department String
  district   String
  services   Service[]

  @@unique([department, district])
}

model Service {
  quotation Quotation?
  deletedAt DateTime?
  @@index([deletedAt])
  id               String        @id @default(cuid())
  company          String
  correlativeCode  String?
  travelMode       TravelMode @default(NONE)
  modality         ClassModality?
  dates            ServiceDay[]
  amount           Decimal       @db.Decimal(10, 2)
  serviceDate      DateTime
  certificatesOnly Boolean       @default(false)
  status           ServiceStatus @default(SCHEDULED)
  invoicedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  courseId       String
  instructorId   String?     // 👈 OPCIONAL
  locationId     String?     // 👈 OPCIONAL
  salespersonId  String

  course        Course      @relation(fields: [courseId], references: [id])
  courses       Course[] @relation("ServiceCourses")
  instructor    Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id])
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id])

  @@index([serviceDate])
  @@index([invoicedAt])
}

model CertificateSale {
  deletedAt DateTime?
  @@index([deletedAt])
  id            String        @id @default(cuid())
  customerName  String
  customerType  CustomerType
  amount        Decimal       @db.Decimal(10, 2)
  saleDate      DateTime
  status        ServiceStatus @default(SCHEDULED)
  invoicedAt    DateTime?
  createdAt     DateTime      @default(now())

  courseId      String
  salespersonId String

  course        Course       @relation(fields: [courseId], references: [id])
  salesperson   Salesperson  @relation(fields: [salespersonId], references: [id])

  @@index([saleDate])
  @@index([invoicedAt])
}

model ServiceDay {
  modality  ClassModality?
  id        String @id @default(cuid())
  date      DateTime
  startTime String?
  endTime   String?
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([date])
}

model AuditLog {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  actorId String
  actorName String
  entity String
  recordId String
  label String
  action String
  salespersonId String?
  before Json?
  after Json?
  @@index([createdAt])
  @@index([salespersonId, createdAt])
}

model MonthlyClose {
  id String @id
  closedAt DateTime?
  closedBy String?
  closedByName String?
}


enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
model Quotation {
  id String @id @default(cuid())
  company String
  contact String @default("")
  participants Int?
  amount Decimal @db.Decimal(10, 2)
  modality ClassModality?
  tentativeDates String[]
  validUntil DateTime?
  followUpDate DateTime?
  conditions String @default("")
  notes String @default("")
  status QuotationStatus @default(DRAFT)
  salespersonId String
  salesperson Salesperson @relation(fields: [salespersonId], references: [id])
  courses Course[] @relation("QuotationCourses")
  serviceId String? @unique
  convertedAt DateTime?
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents QuotationDocument[]
  @@index([salespersonId, createdAt])
}
model QuotationDocument {
  id String @id @default(cuid())
  quotationId String
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name String
  pathname String @unique
  size Int
  state String @default("PENDING")
  createdAt DateTime @default(now())
  @@index([quotationId, state])
}

model CommercialWeekPlan {
  id String @id
  ranges Json
  updatedAt DateTime @updatedAt
}
