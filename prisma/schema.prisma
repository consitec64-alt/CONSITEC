generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES
  REPORTS
}

enum ServiceStatus {
  SCHEDULED
  EXECUTED
  INVOICED
}

enum CustomerType {
  NATURAL_PERSON
  COMPANY
}

model User {
  assignedReports ServiceReport[] @relation("ReportAssignee")
  reportDocuments ReportDocument[] @relation("DocumentUploader")
  tutorialStep Int @default(0)
  tutorialCompleted Boolean @default(false)
  id       String @id @default(cuid())
  username String @unique
  password String
  role     Role
  salespersonId String?
  salesperson Salesperson? @relation(fields: [salespersonId], references: [id], onDelete: SetNull)
}

enum ClassModality {
  VIRTUAL
  IN_PERSON
}

enum TravelMode {
  NONE
  PLANE
  BUS
}

model Instructor {
  address      String?
  dni          String?
  courseNotes  String?
  courses      Course[] @relation("InstructorCourses")
  emoExpiresAt DateTime?
  sctr         Boolean @default(false)
  sctrStartsAt DateTime?
  sctrEndsAt   DateTime?
  carModel     String?
  carPlate     String?
  id       String    @id @default(cuid())
  name     String    @unique
  services Service[]
}

model Course {
  id               String            @id @default(cuid())
  name             String            @unique
  services         Service[]
  certificateSales CertificateSale[]
  instructors      Instructor[] @relation("InstructorCourses")
  groupedServices  Service[] @relation("ServiceCourses")
}

model Salesperson {
  id               String            @id @default(cuid())
  name             String            @unique
  color            String            @default("#234eaa")
  users            User[]
  services         Service[]
  certificateSales CertificateSale[]
}

model Location {
  id         String    @id @default(cuid())
  department String
  district   String
  services   Service[]

  @@unique([department, district])
}

model Service {
  report ServiceReport?
  deletedAt DateTime?
  @@index([deletedAt])
  id               String        @id @default(cuid())
  company          String
  correlativeCode  String?
  travelMode       TravelMode @default(NONE)
  modality         ClassModality?
  dates            ServiceDay[]
  amount           Decimal       @db.Decimal(10, 2)
  serviceDate      DateTime
  certificatesOnly Boolean       @default(false)
  status           ServiceStatus @default(SCHEDULED)
  invoicedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  courseId       String
  instructorId   String?     // 👈 OPCIONAL
  locationId     String?     // 👈 OPCIONAL
  salespersonId  String

  course        Course      @relation(fields: [courseId], references: [id])
  courses       Course[] @relation("ServiceCourses")
  instructor    Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  location      Location?   @relation(fields: [locationId], references: [id])
  salesperson   Salesperson @relation(fields: [salespersonId], references: [id])

  @@index([serviceDate])
  @@index([invoicedAt])
}

model CertificateSale {
  deletedAt DateTime?
  @@index([deletedAt])
  id            String        @id @default(cuid())
  customerName  String
  customerType  CustomerType
  amount        Decimal       @db.Decimal(10, 2)
  saleDate      DateTime
  status        ServiceStatus @default(SCHEDULED)
  invoicedAt    DateTime?
  createdAt     DateTime      @default(now())

  courseId      String
  salespersonId String

  course        Course       @relation(fields: [courseId], references: [id])
  salesperson   Salesperson  @relation(fields: [salespersonId], references: [id])

  @@index([saleDate])
  @@index([invoicedAt])
}

model ServiceDay {
  id        String @id @default(cuid())
  date      DateTime
  startTime String?
  endTime   String?
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date])
  @@index([date])
}

model AuditLog {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  actorId String
  actorName String
  entity String
  recordId String
  label String
  action String
  salespersonId String?
  before Json?
  after Json?
  @@index([createdAt])
  @@index([salespersonId, createdAt])
}

model MonthlyClose {
  id String @id
  closedAt DateTime?
  closedBy String?
  closedByName String?
}


enum ReportStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  DELIVERED
}
model ServiceReport {
  id String @id @default(cuid())
  serviceId String @unique
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status ReportStatus @default(PENDING)
  assigneeId String?
  assignee User? @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate DateTime?
  deliveredAt DateTime?
  notes String @default("")
  folderUrl String?
  finalReportUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents ReportDocument[]
}
model ReportDocument {
  id String @id @default(cuid())
  reportId String?
  report ServiceReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  name String
  pathname String @unique
  contentType String
  size Int
  category String
  sessionDate DateTime?
  uploaderId String?
  uploader User? @relation("DocumentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  uploaderName String
  state String @default("PENDING")
  createdAt DateTime @default(now())
  uploadedAt DateTime?
  @@index([reportId, state])
}
