# Almacenamiento privado para los PDF de cotizaciones (configurar en cada entorno).
BLOB_READ_WRITE_TOKEN=""

# Optional: Cloudflare R2 private storage (takes precedence for new PDFs when complete).
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
