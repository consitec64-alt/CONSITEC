DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consitec"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/consitec"
# Generate independently for each environment; never commit real values.
AUTH_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Autenticación del mantenimiento diario de Papelera (Vercel Cron).
